# Reef developer targets. `make help` lists them.

SHELL := /bin/bash
.DEFAULT_GOAL := help

# Plain builds stamp `git describe --tags` (no --dirty; `-dirty` goes on the commit only),
# falling back to v0.1.0-dev; releases pass VERSION=v…. An empty VERSION (an unset workflow
# variable) counts as not given.
ifeq ($(strip $(VERSION)),)
override VERSION := $(shell git describe --tags 2>/dev/null || echo v0.1.0-dev)
endif
PORT          ?= 4920
SSH_PORT      ?= 4922
DEV_DIR       ?= $(CURDIR)/.dev
DATA_DIR      ?= $(DEV_DIR)/data
SITE_URL      ?= http://localhost:$(PORT)
SOCK          ?= $(DEV_DIR)/reef.sock
PID_FILE      ?= $(DEV_DIR)/reef.pid
LOG_FILE      ?= $(DEV_DIR)/reef.log
CONF          ?= $(DEV_DIR)/reef.conf
MODE_FILE     := $(DEV_DIR)/mode
CARGO_FLAGS   ?=
BIN           := target/debug/reef
# An OpenID Connect provider for `make dev-oidc`: issuer, client id, and the file holding the
# client secret (REEF_OIDC_CLIENT_SECRET in the environment works too).
OIDC_ISSUER      ?=
OIDC_CLIENT_ID   ?= reef
OIDC_SECRET_FILE ?= $(DEV_DIR)/oidc-client-secret
OIDC_NAME        ?= SSO
# Extra TCP listeners for the dev server, e.g. EXTRA_LISTEN=':80' (see dev-runners).
EXTRA_LISTEN  ?=
# Release build targets and where the bundle picks the binaries up.
TARGETS       ?= aarch64-unknown-linux-musl x86_64-unknown-linux-musl
IMAGE         ?= yadvlabs/reef:$(VERSION:v%=%)
PLATFORMS     ?= linux/amd64,linux/arm64
DIST          := dist

export RUST_LOG

# The commit stamped into the binary (build.rs): `<sha>`, with `-dirty` when tracked files have
# changes. Computed on every make run and exported, so cargo re-stamps whenever the tree goes
# clean or dirty (build.rs has rerun-if-env-changed=REEF_COMMIT); plain `cargo build` falls
# back to asking git itself. Override with REEF_COMMIT=... (container builds do).
ifeq ($(origin REEF_COMMIT),undefined)
REEF_COMMIT := $(shell c=$$(git rev-parse --short=12 HEAD 2>/dev/null) && { if [ -n "$$(GIT_OPTIONAL_LOCKS=0 git status --porcelain --untracked-files=no 2>/dev/null)" ]; then echo $$c-dirty; else echo $$c; fi; } || echo unknown)
endif
export REEF_COMMIT

.PHONY: help dev dev-oidc dev-start dev-stop dev-status dev-logs dev-restart dev-build \
        build build-native web web-install web-dev test test-rust test-web e2e lint fmt check \
        release image image-push runner dev-runners migrate clean reset

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}'

# ----- development -------------------------------------------------------------------------

# The dev configuration file. MODE is standalone or oidc; the choice is remembered in
# $(MODE_FILE) so dev-restart keeps it.
define dev_conf
# TOML
# Generated by make dev; overrides go in $(DEV_DIR)/conf.d/*.conf.
listen = ":$(PORT)"
site_url = "$(SITE_URL)"
ssh_listen = ":$(SSH_PORT)"
listen_unix = "$(SOCK)"
listen_extra = [$(foreach l,$(EXTRA_LISTEN),"$(l)",)]
data_dir = "$(DATA_DIR)"
allow_signup = true

[log]
format = "text"

[auth]
mode = "$(MODE)"

[mirror]
allow_file_urls = true

[network]
allow_private_targets = true
endef
export dev_conf

define oidc_conf

[oidc]
issuer = "$(OIDC_ISSUER)"
client_id = "$(OIDC_CLIENT_ID)"
client_secret_file = "$(OIDC_SECRET_FILE)"
display_name = "$(OIDC_NAME)"
link_by_email = true
endef
export oidc_conf

# Write $(CONF) for $(MODE).
define write-conf
	@mkdir -p $(DATA_DIR) $(DEV_DIR)/conf.d
	@echo "$(MODE)" > $(MODE_FILE)
	@printf '%s\n' "$$dev_conf" > $(CONF)
	@if [ "$(MODE)" = oidc ]; then \
	  test -n "$(OIDC_ISSUER)" || { echo "make dev-oidc needs OIDC_ISSUER=https://... (and OIDC_CLIENT_ID, a client secret in $(OIDC_SECRET_FILE) or REEF_OIDC_CLIENT_SECRET)"; exit 1; }; \
	  printf '%s\n' "$$oidc_conf" >> $(CONF); fi
endef

# Start the built server in the background, writing $(PID_FILE) and $(LOG_FILE).
define start-server
	@$(MAKE) --no-print-directory dev-stop >/dev/null
	@$(BIN) config check --config $(CONF) >/dev/null
	@echo "reef: $(SITE_URL)  ssh: $(SSH_PORT)  mode: $(MODE)  data: $(DATA_DIR)  log: $(LOG_FILE)"
	@nohup $(BIN) serve --config $(CONF) > $(LOG_FILE) 2>&1 & echo $$! > $(PID_FILE)
	@for i in $$(seq 1 60); do curl -sf -o /dev/null $(SITE_URL)/readyz && break; sleep 0.25; done; \
	if curl -sf -o /dev/null $(SITE_URL)/readyz; then echo "reef is ready (pid $$(cat $(PID_FILE)))"; \
	else echo "reef did not come up; last log lines:"; tail -20 $(LOG_FILE); exit 1; fi
endef

# Follow the log until Ctrl+C, then stop the server.
define follow-logs
	@trap '$(MAKE) --no-print-directory dev-stop' EXIT; tail -n 20 -f $(LOG_FILE)
endef

dev-build: web ## Build the web UI and the debug binary
	cargo build $(CARGO_FLAGS)

dev: MODE = standalone
dev: dev-build ## Build, start with built-in accounts (open $(SITE_URL); the first account is the site administrator), follow the log; Ctrl+C stops it
	$(call write-conf)
	$(call start-server)
	$(call follow-logs)

dev-oidc: MODE = oidc
dev-oidc: dev-build ## Same, signing in through an OpenID Connect provider: OIDC_ISSUER=... [OIDC_CLIENT_ID=reef] [OIDC_SECRET_FILE=.dev/oidc-client-secret]
	$(call write-conf)
	$(call start-server)
	$(call follow-logs)

dev-start: MODE ?= $(shell cat $(MODE_FILE) 2>/dev/null || echo standalone)
dev-start: dev-build ## Start in the background (MODE=standalone|oidc, default: last used)
	$(call write-conf)
	$(call start-server)

dev-stop: ## Stop the dev server this repo started (pidfile)
	@if [ -f $(PID_FILE) ] && kill -0 $$(cat $(PID_FILE)) 2>/dev/null; then \
	  P=$$(cat $(PID_FILE)); kill $$P; for i in $$(seq 1 120); do kill -0 $$P 2>/dev/null || break; sleep 0.25; done; \
	  kill -0 $$P 2>/dev/null && kill -9 $$P; echo "stopped reef (pid $$P)"; fi; \
	rm -f $(PID_FILE)

dev-status: ## Is the dev server running and ready?
	@if [ -f $(PID_FILE) ] && kill -0 $$(cat $(PID_FILE)) 2>/dev/null; then echo "reef running (pid $$(cat $(PID_FILE))) at $(SITE_URL), mode $$(cat $(MODE_FILE) 2>/dev/null)"; else echo "reef is not running"; fi
	@curl -sf $(SITE_URL)/readyz 2>/dev/null && echo || true

dev-logs: ## Follow the dev server log
	tail -f $(LOG_FILE)

dev-restart: MODE ?= $(shell cat $(MODE_FILE) 2>/dev/null || echo standalone)
dev-restart: ## Restart the dev server with the last build and mode (background)
	$(call write-conf)
	$(call start-server)

# ----- Actions runners --------------------------------------------------------------------

runner: ## Download, register and run a stock actions/runner for REPO=owner/name (needs `make dev-runners`)
	@test -n "$(REPO)" || (echo "usage: make runner REPO=owner/name [LABELS=a,b] [NAME=reef-dev-runner]"; exit 1)
	scripts/dev-runner.sh "$(REPO)" "$(SITE_URL)" "$(LABELS)" "$(NAME)"

dev-runners: ## Like dev-start, but also listening on :80 because stock runners drop the port from --url
	@$(MAKE) dev-start EXTRA_LISTEN=':80' SITE_URL=http://localhost:$(PORT)

# ----- build --------------------------------------------------------------------------------

web/node_modules: web/package.json web/pnpm-lock.yaml
	cd web && pnpm install --frozen-lockfile
	@touch web/node_modules

web-install: web/node_modules ## Install frontend dependencies

web: web/node_modules ## Build the web UI into web/dist
	cd web && pnpm build

web-dev: web/node_modules ## Vite dev server with hot reload, proxying to a running `make dev`
	cd web && REEF_URL=http://localhost:$(PORT) pnpm dev

build: web ## Release binaries for linux/arm64 and linux/amd64 (cargo zigbuild) into bin/linux-<arch>/, UI embedded
	@command -v cargo-zigbuild >/dev/null || { echo "cargo-zigbuild is required: cargo install cargo-zigbuild (and zig); or use make build-native"; exit 1; }
	@for t in $(TARGETS); do \
	  case $$t in aarch64-*) arch=arm64 ;; x86_64-*) arch=amd64 ;; *) echo "unknown arch for $$t"; exit 1 ;; esac; \
	  echo "building $$t"; REEF_VERSION=$(VERSION) cargo zigbuild --locked --release --target $$t $(CARGO_FLAGS) || exit 1; \
	  mkdir -p bin/linux-$$arch && cp target/$$t/release/reef bin/linux-$$arch/reef; \
	done
	@ls -l bin/linux-*/reef

build-native: web ## Release binary for this machine into bin/host/
	REEF_VERSION=$(VERSION) cargo build --locked --release $(CARGO_FLAGS)
	@mkdir -p bin/host && cp target/release/reef bin/host/reef && ls -l bin/host/reef

release: ## Versioned build: make release VERSION=v0.1.0 -> dist/reef-<version>-linux-<arch>.tar.gz + SHA256SUMS
	@cv=v$$(cargo metadata --no-deps --format-version 1 | python3 -c 'import json,sys; print([p for p in json.load(sys.stdin)["packages"] if p["name"]=="reef"][0]["version"])'); \
	  case "$(VERSION)" in "$$cv"|"$$cv"-*) ;; *) echo "VERSION=$(VERSION) is neither the Cargo version $$cv nor a pre-release of it; bump Cargo.toml, web/package.json and the Makefile fallback together"; exit 1 ;; esac
	@$(MAKE) build
	@rm -rf $(DIST) && mkdir -p $(DIST)
	@for arch in arm64 amd64; do \
	  stage=$(DIST)/reef-$(VERSION)-linux-$$arch; mkdir -p $$stage/bin $$stage/units $$stage/conf; \
	  cp bin/linux-$$arch/reef $$stage/bin/; cp deploy/systemd/reef.service $$stage/units/; \
	  cp deploy/reef.conf.example $$stage/conf/reef.conf.example; cp README.md DEPLOY.md LICENSE $$stage/; \
	  tar -C $(DIST) -czf $$stage.tar.gz $$(basename $$stage) && rm -rf $$stage; \
	done
	@cd $(DIST) && shasum -a 256 *.tar.gz > SHA256SUMS && cat SHA256SUMS

image: ## Container image for this machine's architecture from deploy/Dockerfile (IMAGE=yadvlabs/reef:<version>)
	docker build -f deploy/Dockerfile --build-arg REEF_COMMIT=$(REEF_COMMIT) --build-arg REEF_VERSION=$(VERSION) -t $(IMAGE) .

image-push: ## Multi-arch image ($(PLATFORMS)) built with buildx and pushed to IMAGE
	docker buildx build -f deploy/Dockerfile --platform $(PLATFORMS) --build-arg REEF_COMMIT=$(REEF_COMMIT) --build-arg REEF_VERSION=$(VERSION) -t $(IMAGE) --push .

# ----- quality -----------------------------------------------------------------------------

test: test-rust test-web ## Unit tests and the web typecheck; set REEF_TEST_DATABASE_URL=postgres://... to run the data layer on PostgreSQL too

test-rust: ## Rust tests (SQLite; REEF_TEST_DATABASE_URL for PostgreSQL)
	cargo test $(CARGO_FLAGS)

test-web: web/node_modules web ## Typecheck the web UI (after a build, which regenerates the route tree)
	cd web && pnpm typecheck

e2e: dev-build ## End-to-end smoke test: start a throwaway server and drive it over REST, GraphQL, git over HTTP and SSH
	scripts/e2e.sh

lint: ## cargo fmt --check + clippy -D warnings
	cargo fmt --all -- --check
	cargo clippy --all-targets $(CARGO_FLAGS) -- -D warnings

fmt: ## Format Rust code
	cargo fmt --all

check: lint test ## Lint and test

migrate: dev-build ## Apply pending migrations to the dev database
	$(BIN) migrate --config $(CONF)

clean: ## Remove build outputs
	cargo clean
	rm -rf web/dist bin/linux-* bin/host $(DIST)

reset: dev-stop ## Delete the local dev database, repositories and generated config (destructive)
	rm -rf $(DATA_DIR) $(SOCK) $(CONF) $(MODE_FILE)
